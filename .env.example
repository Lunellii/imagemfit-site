# Copie para .env e ajuste os valores para proteger o painel admin.
# Em producao (Hostinger), deixe VITE_ENABLE_ADMIN=true para liberar o acesso.
VITE_ADMIN_EMAIL=admin@imagemfit.local
VITE_ADMIN_PASSWORD=troque-esta-senha
VITE_ENABLE_ADMIN=false

# Base publica opcional para build:
# - Hostinger: /
# - GitHub Pages: /imagemfit-site/
VITE_BASE_PATH=/