# Copie para .env (desenvolvimento local)

# Login admin (frontend)
VITE_ADMIN_EMAIL=admin@imagemfit.local
VITE_ADMIN_PASSWORD=troque-esta-senha
VITE_ENABLE_ADMIN=false

# Modo de armazenamento:
# - local  = localStorage do navegador (padrao no dev)
# - server = usa API Node e salva no servidor
VITE_STORAGE_MODE=local

# Base publica opcional para build:
# - Hostinger: /
# - GitHub Pages: /imagemfit-site/
VITE_BASE_PATH=/
