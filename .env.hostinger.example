# Variaveis para configurar no painel da Hostinger (Web App Node.js)

# Frontend (Vite)
VITE_STORAGE_MODE=server
VITE_ENABLE_ADMIN=true
VITE_ADMIN_EMAIL=admin@seu-dominio.com
VITE_ADMIN_PASSWORD=troque-esta-senha
VITE_BASE_PATH=/

# Backend (Node app-server)
ENABLE_ADMIN=true
ADMIN_EMAIL=admin@seu-dominio.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria
# Use um caminho ABSOLUTO e persistente da conta Hostinger (fora da pasta do app/deploy).
# Exemplo: /home/usuario/ifq-storage
IFQ_STORAGE_DIR=./storage
IFQ_MAX_UPLOAD_BYTES=7000000
